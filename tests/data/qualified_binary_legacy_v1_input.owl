<?xml version="1.0"?>
<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:ex="http://example.org/qualified-binary-fixture#">
  <owl:Ontology rdf:about="http://example.org/qualified-binary-fixture"/>
  <owl:Class rdf:about="http://example.org/qualified-binary-fixture#A">
    <rdfs:subClassOf rdf:resource="http://example.org/qualified-binary-fixture#B"/>
  </owl:Class>
  <owl:Class rdf:about="http://example.org/qualified-binary-fixture#B"/>
  <owl:Class rdf:about="http://example.org/qualified-binary-fixture#C"/>
  <owl:Class rdf:about="http://example.org/qualified-binary-fixture#D">
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="http://example.org/qualified-binary-fixture#A"/>
          <rdf:Description rdf:about="http://example.org/qualified-binary-fixture#C"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
</rdf:RDF>
