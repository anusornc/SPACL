<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#">
  <owl:Class rdf:about="http://example.org/status/A">
    <rdfs:subClassOf rdf:nodeID="nominal"/>
  </owl:Class>
  <rdf:Description rdf:nodeID="nominal"><owl:oneOf rdf:nodeID="list"/></rdf:Description>
  <rdf:Description rdf:nodeID="list">
    <rdf:first>not-an-individual</rdf:first>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
</rdf:RDF>
